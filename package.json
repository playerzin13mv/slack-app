{
  "name": "slack",
  "productName": "Slack",
  "version": "0.2.0",
  "description": "A Discord-style chat platform for desktop (Electron), Android and iOS (Capacitor), with a real-time WebSocket server.",
  "author": "Brenninho",
  "license": "MIT",
  "homepage": "https://github.com/Brenninho/Slack",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "node scripts/build.mjs renderer",
    "build:server": "node scripts/build.mjs server",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json && tsc -p tsconfig.server.json",
    "start": "npm run build && node scripts/start.mjs",
    "server": "npm run build:server && node dist/server/index.js",
    "server:dev": "tsx watch server/src/index.ts",
    "icons": "node scripts/generate-icons.mjs",
    "icons:mobile": "npm run icons && capacitor-assets generate --android --ios",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "dist:linux": "npm run build && electron-builder --linux",
    "mobile:sync": "npm run build:renderer && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ws": "^8.22.0"
  }
}
